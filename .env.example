# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_SITE_URL: Canonical site URL used for SEO metadata, sitemap and JSON-LD.
# Özel alan adı HTTPS ile yayına alınana kadar canlı Netlify adresi kullanılmalı.
VITE_SITE_URL="https://tarhanaterapi.netlify.app"
# Özel alan adı hazır olduğunda: VITE_SITE_URL="https://tarhanaterapi.com"

# Server-side (Vercel env), do NOT expose to client:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=
